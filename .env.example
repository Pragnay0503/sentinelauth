# SentinelAuth - Environment Variables
# Copy this file to .env and fill in your actual secret values.
# Never commit .env to version control.

# JWT signing secret — generate a strong random value for production:
#   python -c "import secrets; print(secrets.token_hex(32))"
SENTINEL_JWT_SECRET=change-this-to-a-strong-random-secret-in-production

# Document image retention threshold in minutes (defaults to 15 if unset):
RETENTION_MINUTES=15
